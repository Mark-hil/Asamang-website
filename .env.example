DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Email Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Site Information
SITE_URL=http://localhost:8000
SITE_NAME=Your Medical Center




{% extends 'base.html' %}
{% load static %}

{% block title %}Our Expert Doctors - {{ block.super }}{% endblock %}

{% block body_class %}doctors-page{% endblock %}

{% block content %}
<main class="main">
  <!-- Page Title -->
  <div class="page-title">
    <div class="heading">
      <div class="container">
        <div class="row d-flex justify-content-center text-center">
          <div class="col-lg-8">
            <h1 class="heading-title">Our Expert Doctors</h1>
            <p class="mb-0">
              Meet our team of experienced and dedicated healthcare professionals.
              Our doctors are committed to providing the highest quality care to our patients.
            </p>
          </div>
        </div>
      </div>
    </div>
    <nav class="breadcrumbs">
      <div class="container">
        <ol>
          <li><a href="{% url 'core:home' %}">Home</a></li>
          <li class="current">Doctors</li>
        </ol>
      </div>
    </nav>
  </div>

  <!-- Doctors Section -->
  <section id="doctors" class="doctors section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <!-- Filterable Doctor Directory -->
      <div class="doctor-directory mb-5">
        <div class="directory-bar p-3 p-md-4 rounded-3">
          <form method="get" class="row g-3 align-items-center">
            <div class="col-lg-4">
              <label for="search" class="form-label mb-1">Search Doctors</label>
              <div class="position-relative">
                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3"></i>
                <input type="text" class="form-control ps-4" id="search" name="search" 
                       placeholder="Search by name or specialization..." value="{{ request.GET.search }}">
              </div>
            </div>
            <div class="col-lg-3">
              <label for="specialization" class="form-label mb-1">Specialization</label>
              <select class="form-select" id="specialization" name="specialization">
                <option value="">All Specializations</option>
                {% for value, label in specializations %}
                  <option value="{{ value }}" {% if request.GET.specialization == value|stringformat:'s' %}selected{% endif %}>
                    {{ label }}
                  </option>
                {% endfor %}
              </select>
            </div>
            <div class="col-lg-3">
              <label for="availability" class="form-label mb-1">Availability</label>
              <select class="form-select" id="availability" name="available">
                <option value="">All Doctors</option>
                <option value="true" {% if request.GET.available == 'true' %}selected{% endif %}>Available Now</option>
              </select>
            </div>
            <div class="col-lg-2 d-flex align-items-end">
              <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel me-2"></i>Filter
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Doctors Grid -->
      <div class="row g-4">
        {% for doctor in doctors %}
        <div class="col-lg-3 col-md-6 d-flex align-items-stretch">
          <div class="doctor-card card h-100 w-100">
            <div class="card-img">
              {% if doctor.image %}
                <img src="{{ doctor.image.url }}" alt="{{ doctor.name }}" class="img-fluid">
              {% else %}
                <img src="{% static 'assets/img/doctors/doctor-placeholder.jpg' %}" alt="{{ doctor.name }}" class="img-fluid">
              {% endif %}
            </div>
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                  <h4 class="mb-1">Dr. {{ doctor.name }}</h4>
                  <p class="text-primary mb-1">{{ doctor.get_specialization_display }}</p>
                  <p class="text-muted small mb-0">{{ doctor.qualifications }}</p>
                </div>
                <div class="text-end">
                  <span class="badge bg-{% if doctor.is_available %}success{% else %}secondary{% endif %} mb-2">
                    {% if doctor.is_available %}Available{% else %}Not Available{% endif %}
                  </span>
                  <p class="text-primary fw-bold mb-0">GHC {{ doctor.consultation_fee|default:"0.00" }}</p>
                  <small class="text-muted">Consultation Fee</small>
                </div>
              </div>
              <p class="card-text">
                {{ doctor.bio|truncatewords:20|default:"No bio available." }}
              </p>
              <div class="doctor-meta mb-3">
                <div class="d-flex align-items-center mb-2">
                  <i class="bi bi-briefcase me-2"></i>
                  <span>{{ doctor.experience }}+ Years Experience</span>
                </div>
                <div class="d-flex align-items-center">
                  <i class="bi bi-clock me-2"></i>
                  <span>{{ doctor.available_days }}, {{ doctor.available_time }}</span>
                </div>
              </div>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0">
              <div class="d-flex justify-content-between align-items-center">
                <a href="{% url 'core:appointment' %}?doctor={{ doctor.id }}" class="btn btn-outline-primary">
                  Book Appointment <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <div class="social-links">
                  {% if doctor.twitter %}
                    <a href="{{ doctor.twitter }}" class="twitter"><i class="bi bi-twitter"></i></a>
                  {% endif %}
                  {% if doctor.facebook %}
                    <a href="{{ doctor.facebook }}" class="facebook"><i class="bi bi-facebook"></i></a>
                  {% endif %}
                  {% if doctor.instagram %}
                    <a href="{{ doctor.instagram }}" class="instagram"><i class="bi bi-instagram"></i></a>
                  {% endif %}
                  {% if doctor.linkedin %}
                    <a href="{{ doctor.linkedin }}" class="linkedin"><i class="bi bi-linkedin"></i></a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
        {% empty %}
        <div class="col-12 text-center py-5">
          <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i> No doctors found matching your criteria.
          </div>
          <a href="{% url 'core:doctors' %}" class="btn btn-outline-primary mt-3">
            Clear Filters
          </a>
        </div>
        {% endfor %}
      </div>

      <!-- Pagination -->
      {% if is_paginated %}
      <div class="pagination justify-content-center mt-5">
        <ul class="pagination">
          {% if page_obj.has_previous %}
            <li class="page-item">
              <a class="page-link" href="?page=1{% if request.GET.search %}&search={{ request.GET.search }}{% endif %}{% if request.GET.specialization %}&specialization={{ request.GET.specialization }}{% endif %}{% if request.GET.available %}&available={{ request.GET.available }}{% endif %}">
                &laquo; First
              </a>
            </li>
            <li class="page-item">
              <a class="page-link" href="?page={{ page_obj.previous_page_number }}{% if request.GET.search %}&search={{ request.GET.search }}{% endif %}{% if request.GET.specialization %}&specialization={{ request.GET.specialization }}{% endif %}{% if request.GET.available %}&available={{ request.GET.available }}{% endif %}">
                Previous
              </a>
            </li>
          {% endif %}

          {% for num in page_obj.paginator.page_range %}
            {% if page_obj.number == num %}
              <li class="page-item active">
                <span class="page-link">{{ num }}</span>
              </li>
            {% elif num > page_obj.number|add:'-3' and num < page_obj.number|add:'3' %}
              <li class="page-item">
                <a class="page-link" href="?page={{ num }}{% if request.GET.search %}&search={{ request.GET.search }}{% endif %}{% if request.GET.specialization %}&specialization={{ request.GET.specialization }}{% endif %}{% if request.GET.available %}&available={{ request.GET.available }}{% endif %}">
                  {{ num }}
                </a>
              </li>
            {% endif %}
          {% endfor %}

          {% if page_obj.has_next %}
            <li class="page-item">
              <a class="page-link" href="?page={{ page_obj.next_page_number }}{% if request.GET.search %}&search={{ request.GET.search }}{% endif %}{% if request.GET.specialization %}&specialization={{ request.GET.specialization }}{% endif %}{% if request.GET.available %}&available={{ request.GET.available }}{% endif %}">
                Next
              </a>
            </li>
            <li class="page-item">
              <a class="page-link" href="?page={{ page_obj.paginator.num_pages }}{% if request.GET.search %}&search={{ request.GET.search }}{% endif %}{% if request.GET.specialization %}&specialization={{ request.GET.specialization }}{% endif %}{% if request.GET.available %}&available={{ request.GET.available }}{% endif %}">
                Last &raquo;
              </a>
            </li>
          {% endif %}
        </ul>
      </div>
      {% endif %}
    </div>
  </section>
</main>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize tooltips
  var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
  var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl);
  });

  // Auto-submit form on filter change
  const filterForm = document.querySelector('form[method="get"]');
  const filterSelects = filterForm ? filterForm.querySelectorAll('select') : [];
  
  filterSelects.forEach(select => {
    select.addEventListener('change', function() {
      filterForm.submit();
    });
  });
});
</script>
{% endblock %}


gallery
{% extends 'base.html' %}
{% load static %}

{% block title %}Gallery - Asamang SDA{% endblock %}

{% block body_class %}gallery-page{% endblock %}

{% block extra_css %}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/css/lightbox.min.css">
  <style>
    /* Custom lightbox styles */
    .lb-outerContainer, 
    .lb-dataContainer {
      background: #fff;
      border-radius: 8px;
    }
    .lb-data .lb-close {
      margin-top: 10px;
      margin-right: 10px;
    }
    .lb-data .lb-caption {
      font-size: 16px;
      line-height: 1.4;
      padding: 15px;
    }
    .lb-data .lb-caption h4 {
      margin-top: 0;
      color: #333;
      font-weight: 600;
    }
    .lb-data .lb-caption p {
      margin-bottom: 0;
      color: #666;
    }
  </style>
{% endblock %}

{% block content %}
  <!-- Page Title -->
  <div class="page-title">
    <div class="heading">
      <div class="container">
        <div class="row d-flex justify-content-center text-center">
          <div class="col-lg-8">
            <h1 class="heading-title">Gallery</h1>
            <p class="mb-0">
              Explore our collection of beautiful moments and memories. 
              From nature to architecture and people, we've captured it all.
            </p>
          </div>
        </div>
      </div>
    </div>
    <nav class="breadcrumbs">
      <div class="container">
        <ol>
          <li><a href="{% url 'core:home' %}">Home</a></li>
          <li class="current">Gallery</li>
        </ol>
      </div>
    </nav>
  </div><!-- End Page Title -->

  <!-- Gallery Section -->
  <section id="gallery" class="gallery section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <div class="isotope-layout" data-default-filter="*" data-layout="masonry" data-sort="original-order">
        <ul class="gallery-filters isotope-filters" data-aos="fade-up" data-aos-delay="200">
          <li data-filter="*" class="filter-active">All</li>
          {% for category_value, category_label in categories %}
            <li data-filter=".filter-{{ category_value|lower }}">{{ category_label }}</li>
          {% endfor %}
        </ul>

        <div class="row gallery-grid isotope-container" data-aos="fade-up" data-aos-delay="300">
          {% for image in gallery_images %}
          <div class="col-xl-3 col-md-4 col-sm-6 gallery-item isotope-item filter-{{ image.category }}">
            <div class="gallery-card">
              <a href="{{ image.image.url }}" 
                 data-lightbox="gallery" 
                 data-title="<h4>{{ image.title }}</h4>{% if image.description %}<p>{{ image.description }}</p>{% endif %}"
                 class="gallery-link">
                <div class="gallery-image">
                  <img src="{{ image.image.url }}" class="img-fluid" alt="{{ image.title }}" loading="lazy">
                </div>
                <div class="gallery-overlay d-flex flex-column justify-content-center align-items-center">
                  <h4 class="text-white text-center mb-2">{{ image.title }}</h4>
                  {% if image.description %}<p class="text-white-50 text-center mb-0">{{ image.description|truncatechars:50 }}</p>{% endif %}
                  <div class="gallery-actions mt-3">
                    <span class="btn-action"><i class="bi bi-eye"></i></span>
                  </div>
                </div>
              </a>
            </div>
          </div>
          {% empty %}
            <div class="col-12 text-center py-5">
              <p>No images found in the gallery.</p>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section><!-- /Gallery Section -->
{% endblock %}

{% block extra_js %}
  <script src="https://unpkg.com/isotope-layout@3/dist/isotope.pkgd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize Isotope
      const galleryIsotope = document.querySelector('.isotope-layout');
      if (galleryIsotope) {
        const iso = new Isotope('.isotope-container', {
          itemSelector: '.gallery-item',
          layoutMode: 'masonry',
          percentPosition: true,
          masonry: {
            columnWidth: '.gallery-item'
          }
        });

        // Filter items on button click
        const galleryFilters = document.querySelectorAll('.isotope-filters li');
        galleryFilters.forEach(function(filter) {
          filter.addEventListener('click', function() {
            galleryFilters.forEach(el => el.classList.remove('filter-active'));
            this.classList.add('filter-active');
            
            const filterValue = this.getAttribute('data-filter');
            iso.arrange({ 
              filter: filterValue === '*' ? '*' : `.filter-${filterValue.replace('.', '')}`
            });
          });
        });

        // Refresh layout when images are loaded
        const images = document.querySelectorAll('.gallery-image img');
        images.forEach(img => {
          img.addEventListener('load', () => {
            iso.layout();
          });
        });
      }

      // Initialize lightbox with options
      lightbox.option({
        'resizeDuration': 200,
        'wrapAround': true,
        'showImageNumberLabel': false,
        'disableScrolling': true,
        'fadeDuration': 200,
        'albumLabel': 'Image %1 of %2'
      });
    });
  </script>
{% endblock %}