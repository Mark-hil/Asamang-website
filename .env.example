# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost

# Neon Database Connection (Recommended)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Or Individual PostgreSQL Variables
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=your_password
# DB_HOST=ep-cool-fog-123456.us-east-2.aws.neon.tech
# DB_PORT=5432

# Admin & Email Configuration
ADMIN_EMAIL=admin@example.com
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Site Information
SITE_NAME="Asamang SDA Hospital"
SITE_URL=http://localhost:8000

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret